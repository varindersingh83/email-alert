# Telegram bot token from @BotFather. Put the real value in .env; never commit it.
TELEGRAM_BOT_TOKEN=

# Optional named destination allowlist. Use one-line JSON, with a lowercase alias,
# user-facing label, and exact chat ID for each private chat or group.
# Example: {"founders":{"label":"Founders group","chat_id":"-1001234567890"},"personal":{"label":"Personal chat","chat_id":"123456789"}}
# To find IDs, add the bot to each group and send /start@YourBotUsername there;
# for a private chat, the user must first send /start to the bot. Then run:
#   python3 get_chat_id.py
#   python3 get_chat_id.py --groups-only
# Match each printed ID to its chat title and type before adding it here.
TELEGRAM_DESTINATIONS_JSON=

# Backward-compatible single destination, exposed to callers as "default".
# Leave blank when using only TELEGRAM_DESTINATIONS_JSON.
TELEGRAM_CHAT_ID=

# Secret required by clients calling this sender service; generate with `openssl rand -hex 32`.
LOCAL_API_KEY=

# PostgreSQL connection URL; Railway can reference another service's DATABASE_URL.
DATABASE_URL=

# Railway injects PORT. HOST should be 0.0.0.0 in hosted services.
HOST=0.0.0.0
PORT=8080

# Max automatic retries for temporary Telegram/network errors (1-100).
MAX_ATTEMPTS=8
