# Telegram bot token from @BotFather (keep the real value in .env only)
TELEGRAM_BOT_TOKEN=

# Private or group chat ID to receive messages
TELEGRAM_CHAT_ID=

# Separate key required by clients calling this sender service
LOCAL_API_KEY=

# PostgreSQL connection URL; Railway can reference another service's DATABASE_URL
DATABASE_URL=

# Railway injects PORT. HOST should be 0.0.0.0 in hosted services.
HOST=0.0.0.0
PORT=8080

# Max automatic retries for temporary Telegram/network errors
MAX_ATTEMPTS=8
