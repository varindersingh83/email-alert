# Telegram bot token from @BotFather (keep the real value in .env only)
TELEGRAM_BOT_TOKEN=

# Gmail mailbox identity used by the email trigger
GMAIL_MAILBOX=founders@asynccraft.com

# Private or group chat ID to receive messages
TELEGRAM_CHAT_ID=

# Separate key required by clients calling this sender service
LOCAL_API_KEY=

# Local-only by default; set HOST=0.0.0.0 only when deploying behind HTTPS
HOST=127.0.0.1
PORT=8080
